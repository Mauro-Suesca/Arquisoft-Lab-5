upstream backend_servers{
    least_conn;
    server localhost:3000;  # Backend 1 (modificar cuando esté el docker)
    server localhost:3001;  # Backend 2 (modificar cuando esté el docker)
}

server{
    #Escuchar requests de HTTP en el puerto 80
    listen 80;

    server_name localhost;
 
    #Requests a la URL (/)
    location / {
        #Proxy a los servers de backend
        proxy_pass http://backend_servers;
        
        #Reenviar headers importantes al server de backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}